# Maintainer: Ben Kuhn <ku0hn@ku0hn.radio>
pkgname=deviation-station
pkgver=0.1.0
pkgrel=1
pkgdesc='A GNU Radio FM deviation instrument for bench work, repeaters, and sound-card modem calibration'
_commit='764b6f4a9b73bd6880640d200a91c874f85d26b7'
arch=('x86_64' 'i686' 'aarch64' 'armv7h')
url='https://github.com/ben-kuhn/deviation-station'
license=('GPL-3.0-or-later')
depends=(
  'python'
  'python-numpy'
  'python-scipy'
  'gnuradio'
  'soapysdr'
  'python-pyqt6'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-hatchling'
)
optdepends=(
  'soapysdr-module-rtlsdr: RTL-SDR support'
  'soapysdr-module-airspy: Airspy support'
  'soapysdr-module-hackrf: HackRF support'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/ben-kuhn/deviation-station/archive/${_commit}.tar.gz")
sha256sums=('f7a0044a09bacb0ee042906bb7f75086601c237adbc41397b8f1228741ddf407')

build() {
  cd "deviation-station-${_commit}"
  python -m build --wheel --no-isolation
}

package() {
  cd "deviation-station-${_commit}"

  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 nix/deviationstation.desktop \
    "$pkgdir/usr/share/applications/deviationstation.desktop"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 INSTALL.md \
    "$pkgdir/usr/share/doc/$pkgname/INSTALL.md"
}
